# LLM Configuration
ECOM_LLM_API_KEY=your_api_key_here
ECOM_LLM_BASE_URL=https://api.minimax.chat/v1
ECOM_LLM_MODEL=MiniMax-M1

# Redis
ECOM_REDIS_URL=redis://localhost:6379/0

# Milvus
ECOM_MILVUS_HOST=localhost
ECOM_MILVUS_PORT=19530

# Database
ECOM_DATABASE_URL=sqlite:///./ecommerce.db

# A/B Testing
ECOM_AB_TEST_ENABLED=true

# Shopping Agent: offline defaults; .env must be explicitly loaded by your shell/server.
SHOPPING_DATABASE_URL=sqlite:///./shopping_agent.db
SHOPPING_EMBEDDING_PROVIDER=hash
SHOPPING_EMBEDDING_MODEL=
SHOPPING_EMBEDDING_BASE_URL=
SHOPPING_EMBEDDING_API_KEY=
SHOPPING_EMBEDDING_ALLOW_REMOTE=false
SHOPPING_EMBEDDING_TIMEOUT_SECONDS=8
SHOPPING_RETRIEVAL_MODE=bm25
# Optional Bailian: provider=bailian, model=text-embedding-v4, allow_remote=true
# base_url=https://dashscope.aliyuncs.com/compatible-mode/v1
# Set the key locally; DASHSCOPE_API_KEY is the fallback environment variable.
# Existing model-only configuration still selects local Ollama (127.0.0.1:11434).
